# Optional specialist. Public website keeps this disabled by default.
FINANCE_SPECIALIST_ENABLED=false

# Optional LLM headline sentiment (batch-scored once per article, cached 6h).
# Shares the specialist allowlist and API keys; reranker providers can replace
# the scorer behind the same interface.
FINANCE_SENTIMENT_LLM_ENABLED=false
FINANCE_SENTIMENT_LLM_PROVIDER=opencode_zen
FINANCE_SENTIMENT_LLM_MODEL=
FINANCE_SENTIMENT_LLM_TIMEOUT=14
FINANCE_SPECIALIST_PROVIDER=google
FINANCE_SPECIALIST_MODEL=gemini-3.5-flash-lite
FINANCE_SPECIALIST_TIMEOUT=30
FINANCE_ALLOW_PAID_MODELS=false
GOOGLE_API_KEY=
OPENCODE_ZEN_API_KEY=

# Web service
PORT=8790
FINANCE_REFRESH_SECONDS=5
FINANCE_DEFAULT_ASSETS=us:NVDA,us:AAPL,hk:00700,cn:601619,crypto:USDT
