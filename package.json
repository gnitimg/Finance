{
  "name": "gnitimg-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.js --host 0.0.0.0",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node server/index.mjs",
    "test:web": "node --test server/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test": "npm run test:web && npm run test:python",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "echarts": "^6.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "remixicon": "^4.9.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
